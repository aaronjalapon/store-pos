{"kind":"textbox","id":"sh/y54n2psj","slide":3,"text":"Create a mobile-friendly system suited to the daily operations of sari-sari stores.","textPreview":"Create a mobile-friendly system suited to the daily operations of sari-sari stores.","textChars":83,"textLines":1,"bbox":[170,258,395,82]}
{"kind":"shape","id":"sh/1cbm10bq","slide":3,"bbox":[78,369,480,2]}
