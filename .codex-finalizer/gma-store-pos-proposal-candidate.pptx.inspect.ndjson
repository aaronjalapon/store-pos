{"kind":"textbox","id":"sh/3qlojuh4","slide":3,"text":"Implement role-based access, synchronization, and encrypted backups.","textPreview":"Implement role-based access, synchronization, and encrypted backups.","textChars":68,"textLines":1,"bbox":[742,471,395,82]}
