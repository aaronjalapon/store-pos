{"kind":"textbox","id":"sh/7y1obahw","slide":3,"text":"Allow staff to complete and save sales without a continuous internet connection.","textPreview":"Allow staff to complete and save sales without a continuous internet connection.","textChars":80,"textLines":1,"bbox":[742,258,395,82]}
