# For the explicitly invoked sample-data setup script only.
# Copy to .env.demo (ignored by Git), then fill in values privately.
DEMO_API_URL=https://YOUR-PROJECT.vercel.app
DEMO_CONFIRM=CREATE_SAMPLE_STORE
SUPERADMIN_EMAIL=YOUR_PRIVATE_ADMIN_EMAIL
SUPERADMIN_PASSWORD=YOUR_PRIVATE_ADMIN_PASSWORD
# Keep this journal between reruns. It contains private demo credentials.
DEMO_STATE_DIR=.demo
