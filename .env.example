# API
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://pos:pos@127.0.0.1:5433/gma_pos
JWT_SECRET=replace-with-at-least-32-random-characters
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=ChangeMeSuperadmin123!
SUPERADMIN_DISPLAY_NAME=Super Admin
BACKUP_ENCRYPTION_ACTIVE_KEY_ID=local-2026-10
BACKUP_ENCRYPTION_KEYS_JSON={"local-2026-10":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
BACKUP_MAX_BYTES=104857600
PRODUCT_IMAGE_MAX_INPUT_BYTES=4194304
PRODUCT_IMAGE_MAX_OUTPUT_BYTES=204800
METRICS_TOKEN=replace-with-at-least-24-random-characters
TRUST_PROXY_HOPS=0

# MinIO backup storage (defaults match docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gma-pos-backups
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
