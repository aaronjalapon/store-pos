# API
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://pos:pos@localhost:5432/gma_pos
JWT_SECRET=replace-with-at-least-32-random-characters
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=ChangeMeSuperadmin123!
SUPERADMIN_DISPLAY_NAME=Super Admin
DEVICE_ENROLLMENT_CODE=change-me-before-use
BACKUP_MAX_BYTES=10485760
PRODUCT_IMAGE_MAX_BYTES=102400

# S3-compatible backup storage (MinIO defaults match docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gma-pos-backups
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
